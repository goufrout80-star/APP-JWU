# app-site (admin) — copy to .env and fill in.
# Mock data + mock auth are used until these are set.

# ─── Supabase ─────────────────────────────────
# Same project as the marketing site's .env (Settings → API).
# NEVER put the service_role key here — anon key only.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
